{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      "react": ["../../frontend/node_modules/@types/react"],
      "react/*": ["../../frontend/node_modules/@types/react/*"],
      "react-dom/*": ["../../frontend/node_modules/@types/react-dom/*"],
      "lucide-react": ["../../frontend/node_modules/lucide-react"]
    }
  },
  "include": ["src"]
}
